# gain_ramp_smoothing (M1, ENG-022, DW-026): a gain step 0 -> 1 ramps linearly over one block.
# The source is a constant 1.0 (an ImpulseNode firing every frame, TEST-004); the two strips'
# centre pan law leaves 0.5 at unity gain (MIX-005).
# A first render with the track's gain at 0 primes its strip's smoother at 0. The gain then
# steps to 1 between renders, so the golden render's first 512-frame block ramps
# 0.5 * (i + 1) / 512 and every later block is 0.5. GoldenTests checks the samples too.
# @node {"kind": "audioClipPlayer", "type": "impulse", "samples": 1, "level": 1}
# @expect {"field": "frames", "value": 24000}
# @expect {"field": "peakDb", "value": -12.04, "tolerance": 0.01, "range": {"start": 255, "end": 256}}
# @expect {"field": "peakDb", "value": -6.02, "tolerance": 0.001}
# @expect {"field": "rmsDb", "value": -6.02, "tolerance": 0.001, "range": {"start": 511, "end": 24000}}
project.new {"name": "gain_ramp_smoothing", "sampleRate": 48000}
command.apply {"command": {"type": "AddTrack", "name": "DC", "kind": "audio"}}
command.apply {"command": {"type": "SetParam", "target": {"kind": "strip", "channel": 2, "param": "gain"}, "value": 0}}
render.offline {"from": 0, "to": 96, "path": "primed.wav", "tail": false, "blockSize": 512}
command.apply {"command": {"type": "SetParam", "target": {"kind": "strip", "channel": 2, "param": "gain"}, "value": 1}}
render.offline {"from": 0, "to": 960, "path": "gain_ramp_smoothing.wav", "tail": false, "blockSize": 512}
