# m7_scene (M7, DSP-030..033, MIX-007, AUTO-002, IO-011, T-077): every M7 built-in in one mix,
# rendered twice on fresh engines: the two renders must be the same bits.
#   "Drums" plays assets/kick_48k.wav on every beat (ticks 0, 960, 1920, 2880) through an EQ (HP
#     40 Hz, peak 1 at 100 Hz +4 dB Q 1.4, peak 2 at 2500 Hz −3 dB, high shelf 8000 Hz +2 dB) and a
#     compressor (threshold −24 dB, ratio 4, attack 5 ms, release 120 ms, knee 6, makeup 4 dB), with
#     a post-fader send to "Verb" whose level is automated 0.5 → 0.9 over the bar.
#   "Tone" (pan −0.3) plays assets/tone_441_48k.wav at ticks 480 and 2400 through a ping-pong delay
#     (1/8 synced, feedback 0.45, lowpass 5000 Hz) whose mix is automated 0 → 1 over two beats
#     (device param lane, linear), with a post-fader send at 0.3 to "Verb".
#   "Verb" is a bus with a reverb insert (size 0.7, decay 1.2 s, damping 0.5, pre-delay 20 ms,
#     mix 1: wet only), out to the master.
# One bar at 120 bpm: 96000 frames. The reverb's tail is still ringing at the end.
# IDs: master 1, Verb 2 (reverb 3), Drums 4 (EQ 5, compressor 6, send 7), Tone 8 (delay 9,
# send 10), kick asset 11, tone asset 12.
# EffectGoldenTests runs it twice on fresh engines and compares the renders bit for bit.
# @expect {"field": "frames", "value": 96000}
# @expect {"field": "peakDb", "value": -4.385, "tolerance": 0.001, "channel": 0}
# @expect {"field": "peakDb", "value": -7.569, "tolerance": 0.001, "channel": 1}
# @expect {"field": "spectrumPeakHz", "value": 441, "tolerance": 2}
project.new {"name": "m7_scene", "sampleRate": 48000}
command.apply {"command": {"type": "RestoreBus", "index": 0, "bus": {"id": 2, "name": "Verb", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "inserts": [{"id": 3, "kind": {"format": "builtin", "node": "reverb"}, "params": [{"index": 0, "value": 0.7}, {"index": 1, "value": 1.2}, {"index": 2, "value": 0.5}, {"index": 3, "value": 20}, {"index": 4, "value": 1}], "bypass": false}], "strip": {"gain": 1, "pan": 0, "mute": false, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "automation": []}}}
command.apply {"command": {"type": "RestoreTrack", "index": 0, "track": {"id": 4, "name": "Drums", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [{"id": 5, "kind": {"format": "builtin", "node": "eq"}, "params": [{"index": 0, "value": 1}, {"index": 1, "value": 40}, {"index": 2, "value": 0.7071067811865476}, {"index": 3, "value": 0}, {"index": 7, "value": 1}, {"index": 8, "value": 100}, {"index": 9, "value": 4}, {"index": 10, "value": 1.4}, {"index": 11, "value": 1}, {"index": 12, "value": 2500}, {"index": 13, "value": -3}, {"index": 14, "value": 1}, {"index": 15, "value": 1}, {"index": 16, "value": 8000}, {"index": 17, "value": 2}, {"index": 18, "value": 0.7071067811865476}, {"index": 19, "value": 0}], "bypass": false}, {"id": 6, "kind": {"format": "builtin", "node": "compressor"}, "params": [{"index": 0, "value": -24}, {"index": 1, "value": 4}, {"index": 2, "value": 5}, {"index": 3, "value": 120}, {"index": 4, "value": 6}, {"index": 5, "value": 4}, {"index": 6, "value": 0}], "bypass": false}], "strip": {"gain": 1, "pan": 0, "mute": false, "solo": false, "phaseInvert": false}, "sends": [{"id": 7, "level": 0.4, "tap": "postFader", "target": 2}], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
command.apply {"command": {"type": "RestoreTrack", "index": 1, "track": {"id": 8, "name": "Tone", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [{"id": 9, "kind": {"format": "builtin", "node": "delay"}, "params": [{"index": 0, "value": 375}, {"index": 1, "value": 1}, {"index": 2, "value": 5}, {"index": 3, "value": 0.45}, {"index": 4, "value": 5000}, {"index": 5, "value": 1}, {"index": 6, "value": 0.35}], "bypass": false}], "strip": {"gain": 1, "pan": -0.3, "mute": false, "solo": false, "phaseInvert": false}, "sends": [{"id": 10, "level": 0.3, "tap": "postFader", "target": 2}], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
asset.import {"path": "assets/kick_48k.wav"}
asset.import {"path": "assets/tone_441_48k.wav"}
command.apply {"command": {"type": "AddClip", "trackID": 4, "start": 0, "assetID": 11}}
command.apply {"command": {"type": "AddClip", "trackID": 4, "start": 960, "assetID": 11}}
command.apply {"command": {"type": "AddClip", "trackID": 4, "start": 1920, "assetID": 11}}
command.apply {"command": {"type": "AddClip", "trackID": 4, "start": 2880, "assetID": 11}}
command.apply {"command": {"type": "AddClip", "trackID": 8, "start": 480, "assetID": 12}}
command.apply {"command": {"type": "AddClip", "trackID": 8, "start": 2400, "assetID": 12}}
command.apply {"command": {"type": "AddAutomationPoints", "target": {"kind": "device", "slot": 9, "index": 6}, "points": [{"tick": 0, "value": 0}, {"tick": 1920, "value": 1}]}}
command.apply {"command": {"type": "AddAutomationPoints", "target": {"kind": "sendLevel", "send": 7}, "points": [{"tick": 0, "value": 0.5}, {"tick": 3840, "value": 0.9}]}}
render.offline {"from": 0, "to": 3840, "path": "m7_scene.wav", "tail": false}
