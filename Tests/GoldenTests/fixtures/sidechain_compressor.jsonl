# sidechain_compressor (M7, DSP-031, MIX-008, T-071): a kick on one track ducks a sustained tone
# on another through the built-in compressor's sidechain input.
# "Pad" plays the 441 Hz tone at 0.5 (assets/tone_441_48k.wav, 35000 frames) through a compressor
# insert keyed by "Kick" (pre-fader sidechain). "Kick" plays assets/kick_48k.wav (a 150 → 50 Hz
# sweep, peak ≈ 0.9, 9600 frames) at ticks 240, 720 and 1200 (frames 6000, 18000, 30000) and is
# muted, so only the ducked tone is heard: a pre-fader sidechain still keys when its source is
# muted (MIX-008 ghost trigger). Compressor: threshold −30 dB, ratio 4, attack 5 ms, release
# 80 ms, knee 6 dB, makeup 0, peak detector. Centre pans on Pad and the master give × 0.5.
#   Before the first kick (frames 0..6000) the tone is untouched: peak 0.25 = −12.04 dBFS.
#   From the kick's first sample over −33 dB the gain drops (0 latency, no lookahead) and
#   recovers with the 80 ms release between kicks.
# IDs: master 1, Kick 2, Pad 3 (compressor insert 4), tone asset 5, kick asset 6.
# SidechainCompressorGoldenTests checks every sample against tone × 0.5 × an oracle gain keyed
# by the kick asset.
# @expect {"field": "frames", "value": 36000}
# @expect {"field": "peakDb", "value": -12.041, "tolerance": 0.001, "range": {"start": 0, "end": 6000}}
# @expect {"field": "spectrumPeakHz", "value": 441, "tolerance": 2}
project.new {"name": "sidechain_compressor", "sampleRate": 48000}
command.apply {"command": {"type": "RestoreTrack", "index": 0, "track": {"id": 2, "name": "Kick", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [], "strip": {"gain": 1, "pan": 0, "mute": true, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
command.apply {"command": {"type": "RestoreTrack", "index": 1, "track": {"id": 3, "name": "Pad", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [{"id": 4, "kind": {"format": "builtin", "node": "compressor"}, "params": [{"index": 0, "value": -30}, {"index": 1, "value": 4}, {"index": 2, "value": 5}, {"index": 3, "value": 80}, {"index": 4, "value": 6}, {"index": 5, "value": 0}, {"index": 6, "value": 0}], "bypass": false, "sidechainSource": {"source": 2, "tap": "preFader"}}], "strip": {"gain": 1, "pan": 0, "mute": false, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
asset.import {"path": "assets/tone_441_48k.wav"}
asset.import {"path": "assets/kick_48k.wav"}
command.apply {"command": {"type": "AddClip", "trackID": 3, "start": 0, "assetID": 5}}
command.apply {"command": {"type": "AddClip", "trackID": 2, "start": 240, "assetID": 6}}
command.apply {"command": {"type": "AddClip", "trackID": 2, "start": 720, "assetID": 6}}
command.apply {"command": {"type": "AddClip", "trackID": 2, "start": 1200, "assetID": 6}}
render.offline {"from": 0, "to": 1440, "path": "sidechain_compressor.wav", "tail": false}
