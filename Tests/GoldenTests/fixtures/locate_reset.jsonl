# locate_reset (M3, TIME-008, DW-073, DW-063, DW-197): the start of a render is a locate while
# playing, which resets the clip player; and since T-089 (DW-063, user decision: offline renders
# reset every node) it resets every other node too, so the render doesn't depend on what played
# before. Fixtures can't locate in the middle of a render: render.offline turns the loop off and
# starts with play() then locate(from) (OfflineDriver). So the locate here is the start of a second
# render that doesn't continue the first one. Live, a locate resets only the timeline nodes and
# effects keep their state (TIME-008); that is checked in C++: TransportTests "locateFlagsReset"
# (locateWhilePlayingFlagsReset) and OfflineResetTests "resetsEveryNode" (offlineResetsEveryNode:
# a live locate keeps the reverb and delay tails).
# Two tracks, IDs written out (RestoreTrack places the insert): master 1, Clip 2, Effect 3
# (insert 4), tone asset 5.
#   L: "Clip" (pan -1) plays assets/tone_441_48k.wav (441 Hz at 0.5) from tick 0.
#   R: "Effect" (pan +1) plays the same tone through a built-in reverb insert at its defaults
#      (DW-197, T-092: a real effect with a tail instead of T-036's SineNode): clip A over ticks
#      0..400 (samples 0..10000) and clip B over ticks 1100..1160 (samples 27500..29000).
# The first render plays ticks 0..480 (12000 frames, 24 blocks of 512: 12288 rendered): clip A
# into the reverb, then 2000 frames of its tail alone. The golden render is ticks 1000..1240
# (samples 25000..31000):
#   L = √½ · tone[25000 + f] from frame 0, at full level. Without the reset the clip player would
#       treat the jump as a loop wrap and crossfade over 64 frames from where the first render
#       stopped (sample 12288), so frame 0 would play the new pass at 1/64.
#   R = exactly 0 until clip B starts at frame 2500: the render reset the reverb, so the first
#       render's tail (still ringing at its end) doesn't leak in. Then √½ · 0.7 · tone (the dry
#       part at mix 0.3) until the first wet sample at frame 2500 + 480 + 1386 (pre-delay 10 ms,
#       shortest line at size 0.5), the reverb's own tail of clip B after it: exact 0 from the
#       clip's end at frame 4000 until then, and a real tail to the end.
# M3GoldenTests checks the samples.
# @expect {"field": "frames", "value": 6000}
# @expect {"field": "peakDb", "value": -9.719, "tolerance": 0.001, "channel": 0, "range": {"start": 0, "end": 1}}
# @expect {"field": "peakDb", "value": -240, "channel": 1, "range": {"start": 0, "end": 2500}}
# @expect {"field": "peakDb", "value": -240, "channel": 1, "range": {"start": 4000, "end": 4366}}
# @expect {"field": "rmsDb", "value": -12.041, "tolerance": 0.01, "channel": 0}
# @expect {"field": "rmsDb", "value": -21.05, "tolerance": 0.01, "channel": 1}
project.new {"name": "locate_reset", "sampleRate": 48000}
command.apply {"command": {"type": "RestoreTrack", "index": 0, "track": {"id": 2, "name": "Clip", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [], "strip": {"gain": 1, "pan": -1, "mute": false, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
command.apply {"command": {"type": "RestoreTrack", "index": 1, "track": {"id": 3, "name": "Effect", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [{"id": 4, "kind": {"format": "builtin", "node": "reverb"}, "params": [], "bypass": false}], "strip": {"gain": 1, "pan": 1, "mute": false, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
asset.import {"path": "assets/tone_441_48k.wav"}
command.apply {"command": {"type": "AddClip", "trackID": 2, "start": 0, "assetID": 5}}
command.apply {"command": {"type": "AddClip", "trackID": 3, "start": 0, "length": 400, "assetID": 5}}
command.apply {"command": {"type": "AddClip", "trackID": 3, "start": 1100, "length": 60, "assetID": 5}}
render.offline {"from": 0, "to": 480, "path": "first_pass.wav", "tail": false}
render.offline {"from": 1000, "to": 1240, "path": "locate_reset.wav", "tail": false}
