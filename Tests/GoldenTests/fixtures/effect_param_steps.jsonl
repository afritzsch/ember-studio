command.apply {"command": {"type": "AddClip", "trackID": 8, "start": 4320, "assetID": 10}}
command.apply {"command": {"type": "AddAutomationPoints", "target": {"kind": "device", "slot": 3, "index": 9}, "points": [{"tick": 0, "value": 0.5, "curve": "hold"}, {"tick": 720, "value": 0.75}]}}
