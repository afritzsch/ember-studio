command.apply {"command": {"type": "AddAutomationPoints", "target": {"kind": "device", "slot": 7, "index": 6}, "points": [{"tick": 2880, "value": 0, "curve": "hold"}, {"tick": 3600, "value": 1}]}}
command.apply {"command": {"type": "AddAutomationPoints", "target": {"kind": "device", "slot": 9, "index": 4}, "points": [{"tick": 4320, "value": 0, "curve": "hold"}, {"tick": 5040, "value": 1}]}}
