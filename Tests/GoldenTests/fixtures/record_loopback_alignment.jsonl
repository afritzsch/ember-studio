# record_loopback_alignment (REC-003, REC-004, REC-005, T-052): a take recorded through the fake
# device's loopback lands sample-exact on the timeline.
# The realtime engine runs Fake Device A (48 kHz, buffer 256): input and output latency are 256
# samples each, and the loopback feeds the output back to the input 512 samples later. The project
# metronome (level 0.5) plays into the outputs while the armed audio track "Mic" records input
# pair 0 through a punch range of ticks [480, 3360) = samples [12000, 84000). Stopping finalizes
# the take: one undoable ImportAsset + AddClip (REC-004) at the punch-in. The export then leaves
# the click out (render.offline without includeMetronome), so all that sounds is the recording.
# Beats 2..4 (samples 24000, 48000, 72000) are inside the punch, beat 5 (96000) isn't.
# The click's first sample is the loudest of a beat (level 0.5 · cos 0), heard through the Mic
# strip's and the master's centre pans (√½ each): 0.25 = −12.041 dBFS. Sample 23999 is silent and
# 24000 is the click's first: off by one sample either way would fail (REC-003: ±1).
# T-054: the track's monitoring is off. With the default `auto`, an armed track monitors while it
# records (REC-020), and through the loopback that is a feedback loop: the take would hold the
# click's echoes, which isn't what this fixture checks.
# @expect {"field": "frames", "value": 120000}
# @expect {"field": "peakDb", "value": -240, "range": {"start": 0, "end": 23999}}
# @expect {"field": "peakDb", "value": -12.041, "tolerance": 0.002, "range": {"start": 24000, "end": 24001}}
# @expect {"field": "peakDb", "value": -12.041, "tolerance": 0.002, "range": {"start": 48000, "end": 48001}}
# @expect {"field": "peakDb", "value": -12.041, "tolerance": 0.002, "range": {"start": 72000, "end": 72001}}
# @expect {"field": "peakDb", "value": -240, "range": {"start": 47000, "end": 47999}}
# @expect {"field": "peakDb", "value": -240, "range": {"start": 84000, "end": 120000}}
project.new {"name": "record_loopback_alignment", "sampleRate": 48000, "engine": {"mode": "realtime", "driver": "fake"}}
command.apply {"command": {"type": "AddTrack", "kind": "audio", "name": "Mic"}}
command.apply {"command": {"type": "ArmTrack", "trackID": 2, "armed": true, "inputPair": 0}}
command.apply {"command": {"type": "SetMonitoring", "trackID": 2, "mode": "off"}}
transport.setMetronome {"enabled": true, "level": 0.5}
transport.setPunch {"enabled": true, "start": 480, "end": 3360}
transport.record {"enabled": true}
transport.play {}
transport.wait {"untilTick": 3840, "timeoutMs": 10000}
transport.stop {}
transport.record {"enabled": false}
command.apply {"command": {"type": "ArmTrack", "trackID": 2, "armed": false}}
render.offline {"from": 0, "to": 4800, "path": "record_loopback_alignment.wav", "tail": false}
