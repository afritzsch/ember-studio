# builtin_bypass_null (M7, PLUG-018 for the built-ins, DSP-030..033, T-077): a bypassed built-in
# EQ, compressor, delay and reverb pass their input through untouched, so a bypassed chain nulls
# against a plain phase-inverted copy, while the same chain running is clearly heard.
# All three tracks play assets/kick_48k.wav at tick 0.
#   L: "Bypassed" (EQ peak 1 at 100 Hz +12 dB and high shelf −12 dB; compressor threshold −30 dB,
#      ratio 10, makeup 6 dB; delay 1/8 synced, feedback 0.5, ping-pong, mix 0.5; reverb mix 0.5)
#      with every insert bypassed: EQ and compressor stored bypassed in the track, delay and
#      reverb by SetDeviceBypass (a slot write). "Plain" plays the kick phase-inverted. Built-ins
#      have no latency, so they null exactly: L is 0 on every frame.
#   R: "Active", the same chain running: the kick, boosted, compressed, echoed and reverberated.
# IDs: master 1, Bypassed 2 (inserts 3..6), Plain 7, Active 8 (inserts 9..12), kick asset 13.
# EffectGoldenTests checks L sample for sample and that R differs from the dry kick.
# @expect {"field": "frames", "value": 24000}
# @expect {"field": "peakDb", "value": -240, "channel": 0}
# @expect {"field": "peakDb", "value": -20.896, "tolerance": 0.001, "channel": 1}
project.new {"name": "builtin_bypass_null", "sampleRate": 48000}
command.apply {"command": {"type": "RestoreTrack", "index": 0, "track": {"id": 2, "name": "Bypassed", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [{"id": 3, "kind": {"format": "builtin", "node": "eq"}, "params": [{"index": 0, "value": 0}, {"index": 3, "value": 0}, {"index": 7, "value": 1}, {"index": 8, "value": 100}, {"index": 9, "value": 12}, {"index": 10, "value": 1}, {"index": 11, "value": 0}, {"index": 15, "value": 1}, {"index": 16, "value": 8000}, {"index": 17, "value": -12}, {"index": 18, "value": 0.7071067811865476}, {"index": 19, "value": 0}], "bypass": true}, {"id": 4, "kind": {"format": "builtin", "node": "compressor"}, "params": [{"index": 0, "value": -30}, {"index": 1, "value": 10}, {"index": 2, "value": 1}, {"index": 3, "value": 50}, {"index": 4, "value": 0}, {"index": 5, "value": 6}, {"index": 6, "value": 0}], "bypass": true}, {"id": 5, "kind": {"format": "builtin", "node": "delay"}, "params": [{"index": 0, "value": 375}, {"index": 1, "value": 1}, {"index": 2, "value": 5}, {"index": 3, "value": 0.5}, {"index": 4, "value": 20000}, {"index": 5, "value": 1}, {"index": 6, "value": 0.5}], "bypass": false}, {"id": 6, "kind": {"format": "builtin", "node": "reverb"}, "params": [{"index": 0, "value": 0.5}, {"index": 1, "value": 1}, {"index": 2, "value": 0.5}, {"index": 3, "value": 10}, {"index": 4, "value": 0.5}], "bypass": false}], "strip": {"gain": 1, "pan": -1, "mute": false, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
command.apply {"command": {"type": "RestoreTrack", "index": 1, "track": {"id": 7, "name": "Plain", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [], "strip": {"gain": 1, "pan": -1, "mute": false, "solo": false, "phaseInvert": true}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
command.apply {"command": {"type": "RestoreTrack", "index": 2, "track": {"id": 8, "name": "Active", "kind": "audio", "color": {"red": 0.5, "green": 0.5, "blue": 0.5}, "clips": [], "takeFolders": [], "inserts": [{"id": 9, "kind": {"format": "builtin", "node": "eq"}, "params": [{"index": 0, "value": 0}, {"index": 3, "value": 0}, {"index": 7, "value": 1}, {"index": 8, "value": 100}, {"index": 9, "value": 12}, {"index": 10, "value": 1}, {"index": 11, "value": 0}, {"index": 15, "value": 1}, {"index": 16, "value": 8000}, {"index": 17, "value": -12}, {"index": 18, "value": 0.7071067811865476}, {"index": 19, "value": 0}], "bypass": false}, {"id": 10, "kind": {"format": "builtin", "node": "compressor"}, "params": [{"index": 0, "value": -30}, {"index": 1, "value": 10}, {"index": 2, "value": 1}, {"index": 3, "value": 50}, {"index": 4, "value": 0}, {"index": 5, "value": 6}, {"index": 6, "value": 0}], "bypass": false}, {"id": 11, "kind": {"format": "builtin", "node": "delay"}, "params": [{"index": 0, "value": 375}, {"index": 1, "value": 1}, {"index": 2, "value": 5}, {"index": 3, "value": 0.5}, {"index": 4, "value": 20000}, {"index": 5, "value": 1}, {"index": 6, "value": 0.5}], "bypass": false}, {"id": 12, "kind": {"format": "builtin", "node": "reverb"}, "params": [{"index": 0, "value": 0.5}, {"index": 1, "value": 1}, {"index": 2, "value": 0.5}, {"index": 3, "value": 10}, {"index": 4, "value": 0.5}], "bypass": false}], "strip": {"gain": 1, "pan": 1, "mute": false, "solo": false, "phaseInvert": false}, "sends": [], "output": {"kind": "master"}, "armed": false, "monitoring": "auto", "automation": []}}}
asset.import {"path": "assets/kick_48k.wav"}
command.apply {"command": {"type": "AddClip", "trackID": 2, "start": 0, "assetID": 13}}
command.apply {"command": {"type": "AddClip", "trackID": 7, "start": 0, "assetID": 13}}
command.apply {"command": {"type": "AddClip", "trackID": 8, "start": 0, "assetID": 13}}
command.apply {"command": {"type": "SetDeviceBypass", "slotID": 5, "bypass": true}}
command.apply {"command": {"type": "SetDeviceBypass", "slotID": 6, "bypass": true}}
render.offline {"from": 0, "to": 960, "path": "builtin_bypass_null.wav", "tail": false}
