// Test-only view of the engine: the internal headers that the DAWEngine module map deliberately
// hides from Swift (01-build-layout Interfaces), plus the test-support headers next to this file.
// Only test targets depend on DAWEngineTestSupport, so only they can import it.
// Paths into Sources/DAWEngine are relative to this file. See specs/14-testing.md, "C++ unit tests".
module DAWEngineTestSupport {
  header "../../../Sources/DAWEngine/core/ParamSlotTable.h"
  header "../../../Sources/DAWEngine/core/ParamSmoother.h"
  header "../../../Sources/DAWEngine/core/RtTrap.h"
  header "../../../Sources/DAWEngine/time/TempoMap.h"
  header "AudioFileChecks.h"
  header "AudioFileWriterChecks.h"
  header "Checks.h"
  header "ChannelStripChecks.h"
  header "ClipPlayerChecks.h"
  header "CoreUtilsChecks.h"
  header "DeviceDriverChecks.h"
  header "DeviceMonitorChecks.h"
  header "EngineChecks.h"
  header "FacadeChecks.h"
  header "FacadeDeviceChecks.h"
  header "FakeDeviceChecks.h"
  header "GraphChecks.h"
  header "MidiClipPlayerChecks.h"
  header "OfflineChecks.h"
  header "ParamChecks.h"
  header "PdcChecks.h"
  header "RtTrapTestSupport.h"
  header "SendChecks.h"
  header "TelemetryChecks.h"
  header "TempoMapTestSupport.h"
  header "TestNodeChecks.h"
  header "TransportChecks.h"
  header "SamplerChecks.h"
  header "MetronomeChecks.h"
  header "SidechainChecks.h"
  header "MidiRoutingChecks.h"
  header "CompressorChecks.h"
  header "ReverbChecks.h"
  header "SessionRateChecks.h"
  requires cplusplus
  export *
}

// T-019: the golden tests' engine (GoldenEngineSupport.h). A module of its own because it shows
// only public facade types, so GoldenTests import it without the engine-internal include root
// and DAW_RT_TRAP flags that importing DAWEngineTestSupport needs.
module DAWGoldenSupport {
  header "GoldenEngineSupport.h"
  requires cplusplus
  export *
}
