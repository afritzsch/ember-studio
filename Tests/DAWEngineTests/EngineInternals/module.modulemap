// Test-only view of engine headers that the DAWEngine module map deliberately hides from Swift
// (01-build-layout Interfaces). Only DAWEngineTests loads it, via -fmodule-map-file in Package.swift.
module DAWEngineInternals {
  header "../../../Sources/DAWEngine/time/TempoMap.h"
  header "TempoMapTestSupport.h"
  requires cplusplus
  export *
}
